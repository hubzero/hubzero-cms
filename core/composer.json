{
    "name": "hubzero/cms",
    "description": "HUBzero CMS",
    "type": "project",
    "keywords": ["cms", "hubzero"],
    "homepage": "http://hubzero.org",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Hubzero",
            "email": "support@hubzero.org",
            "role": "Platform for Scientific Computing"
        }
    ],
    "support": {
        "email": "support@hubzero.org",
        "issues": "http://help.hubzero.org/support/ticket/new",
        "source": "http://hubzero.org/download"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/hubzero/flysystem-github"
        }
    ],
    "require": {
        "apereo/phpcas": "1.6.*",
        "bordoni/phpass": "0.3.*",
        "bshaffer/oauth2-server-php": "1.11.*",
        "cebe/markdown": "^1.2",
        "cilogon/oauth2-cilogon": "1.1.*",
        "composer/composer": "2.8.*",
        "ezyang/htmlpurifier": "4.18.*",
        "geocoder-php/arcgis-online-provider": "4.5.*",
        "geocoder-php/bing-maps-provider": "4.4.*",
        "geocoder-php/chain-provider": "4.5.*",
        "geocoder-php/common-http": "4.6.*",
        "geocoder-php/geo-plugin-provider": "4.4.*",
        "geocoder-php/geonames-provider": "4.5.*",
        "geocoder-php/google-maps-provider": "4.8.*",
        "geocoder-php/host-ip-provider": "4.5.*",
        "geocoder-php/ip-info-db-provider": "4.4.*",
        "geocoder-php/ipstack-provider": "0.4.*",
        "geocoder-php/mapquest-provider": "4.4.*",
        "geocoder-php/maxmind-binary-provider": "4.4.*",
        "geocoder-php/maxmind-provider": "4.5.*",
        "geocoder-php/nominatim-provider": "5.8.*",
        "geocoder-php/tomtom-provider": "4.5.*",
        "geocoder-php/yandex-provider": "4.6.*",
        "google/apiclient": "2.14.*",
        "guzzlehttp/guzzle": "7.9.*",
        "http-interop/http-factory-guzzle": "^1.0",
        "hubzero/orcid-php": "0.3.*",
        "league/flysystem": "1.1.*",
        "league/flysystem-aws-s3-v3": "1.0.*",
        "league/oauth2-client": "~2.8.1",
        "league/oauth2-facebook": "2.0.*",
        "league/oauth2-linkedin": "^5.1",
        "litesaml/lightsaml": "2.3.*",
        "monolog/monolog": "1.27.*",
        "nao-pon/flysystem-google-drive": "1.1.*",
        "pear/archive_tar": "^1.6",
        "pear/net_dns2": "1.5.*",
        "pelago/emogrifier": "7.0.*",
        "php-amqplib/php-amqplib": "2.12.*",
        "php-http/curl-client": "2.3.*",
        "phpdocumentor/reflection-docblock": "5.2.*",
        "phpoffice/phpspreadsheet": "1.30.*",
        "phpspec/php-diff": "^1.1",
        "potherca/flysystem-github": "0.3.*",
        "predis/predis": "1.1.*",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "scrivo/highlight.php": "^9.18",
        "simplepie/simplepie": "1.7.*",
        "simshaun/recurr": "4.0.*",
        "smolblog/oauth2-twitter": "^1.2",
        "solarium/solarium": "6.2.*",
        "splitbrain/lesserphp": "0.10.*",
        "spomky-labs/otphp": "^11.4",
        "srmklive/flysystem-dropbox-v2": "1.0.*",
        "stevenmaguire/oauth2-dropbox": "3.1.*",
        "symfony/console": "v5.4.*",
        "symfony/event-dispatcher": "v5.0.11",
        "symfony/http-foundation": "5.4.*",
        "symfony/mailchimp-mailer": "v5.4.*",
        "symfony/mailer": "v5.2.*",
        "symfony/yaml": "4.*",
        "tecnickcom/tcpdf": "6.8.*",
        "theiconic/name-parser": "0.1.*",
        "voku/simple_html_dom": "^4.8",
        "willdurand/geocoder": "4.6.*"
    },
    "require-dev": {
        "mockery/mockery": "1.3.*",
        "php-coveralls/php-coveralls": "2.7.*",
        "php-parallel-lint/php-parallel-lint": "1.4.*",
        "phpcompatibility/php-compatibility": "*",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "3.11.*"
    },
    "autoload": {
        "psr-4": {
            "Hubzero\\": "libraries/Hubzero/",
            "Bootstrap\\": "bootstrap/"
        },
        "files": [
            "bootstrap/app.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "simplesamlphp/composer-module-installer": true
        },
        "platform": {
            "php": "8.2.30"
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": "\"vendor/bin/phpcs\" --config-set installed_paths vendor/phpcompatibility/php-compatibility",
        "post-update-cmd": "\"vendor/bin/phpcs\" --config-set installed_paths vendor/phpcompatibility/php-compatibility"
    }
}
