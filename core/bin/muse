#!/usr/bin/php
<?php

/**
 * @package    hubzero-cms
 * @copyright  Copyright (c) 2005-2025 The Regents of the University of California.
 * @license    http://opensource.org/licenses/MIT MIT
 */

// Load system classes (before autoloading is available)
require_once dirname(__DIR__) . '/libraries/Hubzero/System/UserEnvironment.php';
require_once dirname(__DIR__) . '/libraries/Hubzero/System/PrivilegeManager.php';
require_once dirname(__DIR__) . '/libraries/Hubzero/Console/PrivilegeNotifier.php';

use Hubzero\System\UserEnvironment;
use Hubzero\System\PrivilegeManager;
use Hubzero\Console\PrivilegeNotifier;

// Check for Windows - HUBzero does not support Windows
if (UserEnvironment::getInstance()->isWindows()) {
    fwrite(STDERR, UserEnvironment::getInstance()->renderUnsupportedOsError(true));
    exit(1);
}

// Handle privilege detection and user prompts
if (!(new PrivilegeNotifier())->handleStartup()) {
    // User declined to continue as root
    exit(1);
}

// Suppress session warnings in CLI mode when output has already been sent
// (session operations warn about "headers already sent" but work fine in CLI)
if (PrivilegeManager::getInstance()->isSudo() || PrivilegeManager::getInstance()->isRoot()) {
    error_reporting(E_ALL & ~E_WARNING);
}

if (@include(dirname(__DIR__) . '/vendor/autoload.php'))
{
    (new Hubzero\Base\Application())->run();
}
else // Start Minimal Muse
{
    // Use local variables instead of constants to avoid conflicts with app.php
    $minimalVersion = '2.4.1';
    $minimalDate = '2025-02-09 11:51:22';

    $ansi = true;
    $help = false;
    $quiet = false;
    $verbose = 0;
    $silent = false;
    $version = false;

    function aecho($text, $error = false)
    {
        global $ansi, $silent, $quiet;

        if (!$silent && (!$quiet || $error))
        {
            if (!$ansi)
            {
                $text = preg_replace("/\e\[\d\dm/","",$text);
                $text = preg_replace("/\e\[\d\d;\d\dm/","",$text);
            }

            echo($text);
        }
    }

    function options()
    {
        aecho("\e[33mOptions:\e[39m\n");
        aecho("\e[32m  -h, --help\e[39m                      Display help for the given command. When no command is given display help for the \e[32mlist\e[39m command\n");
        aecho("\e[32m      --silent\e[39m                    Do not output any message\n");
        aecho("\e[32m  -q, --quiet\e[39m                     Only errors are displayed. All other output is suprressed\n");
        aecho("\e[32m      --ansi|--no-ansi\e[39m            Force (or disable --no-ansi) ANSI output\n");
        aecho("\e[32m  -v|vv|vvv, --verbose\e[39m            Increase the verbosity of messages: 1 for normal output, 2 for more verbose output and 3 for debug\n");
    }

    for($arg = 1; $arg < $argc; $arg++)
    {
        if ($argv[$arg] == '--')
        {
            array_splice($argv,$arg,1);
            $argc--;
            break;
        }
        else if ($argv[$arg] == '--ansi')
        {
            $ansi = true;
            $arg--;
        }
        else if ($argv[$arg] == '--no-ansi')
        {
            $ansi = false;
            array_splice($argv,$arg,1);
            $argc--;
            $arg--;
        }
        if ($argv[$arg] == '--help' || $argv[$arg] == '-h')
        {
            $help = true;
            array_splice($argv,$arg,1);
            $argc--;
            $arg--;
        }
        else if (preg_match("/^\-v+$/", $argv[$arg]))
        {
            $v = array_splice($argv,$arg,1);
            $verbose = min(3, $verbose + strlen($v[0]) - 1);
            $argc--;
            $arg--;
        }
        else if ($argv[$arg] == '--verbose')
        {
            $verbose = ($verbose < 3) ? $verbose + 1 : $verbose;
            array_splice($argv,$arg,1);
            $argc--;
            $arg--;
        }
        else if ($argv[$arg] == '--silent')
        {
            $silent = true;
            array_splice($argv,$arg,1);
            $argc--;
            $arg--;
        }
        else if ($argv[$arg] == '--quiet')
        {
            $quiet = true;
            array_splice($argv,$arg,1);
            $argc--;
            $arg--;
        }
        else if ($argv[$arg] == '--version' || $argv[$arg] == '-V')
        {
            $version = true;
            array_splice($argv,$arg,1);
            $argc--;
            $arg--;
        }
        else if ($argv[$arg][0] == '-') // throw out options we don't know
        {
            array_splice($argv,$arg,1);
            $argc--;
            $arg--;
        }
    }

    if ($argc == 1 || $argv[1][0] == '-') // use list if no command given
    {
        $argc++;
        array_splice($argv, 1, 0, array('list'));
    }

    if ($help)
    {
        $argc++;
        array_splice($argv, 1, 0, array('help'));
    }

    if ($version)
    {
        aecho("\e[32mMuse: HUBzero Command Line Interface\e[39m version \e[33m" . $minimalVersion . " (minimal)\e[39m " . $minimalDate . "\n");
    }
    else if ($argv[1] == 'help')
    {
        if ($argc == 2 || $argv[2] == 'help')
        {
            aecho("\e[33mDescription:\e[39m\n");
            aecho("  Display help for a comand\n");
            aecho("\n");
            aecho("\e[33mUsage:\e[39m\n");
            aecho("  help [options] [--] [<command_name>]\n");
            aecho("\n");
            aecho("\e[33mArguments:\e[39m\n");
            aecho("  \e[32mcommand_name\e[39m                    The command name \e[33m[default: \"help\"]\e[39m\n");
            aecho("\n");
            options();
            aecho("\n");
            aecho("\e[33mHelp:\e[39m\n");
            aecho("  The \e[32mhelp\e[39m command displays help for a given command:\n");
            aecho("\n");
            aecho("    \e[32m{$argv[0]} help list\e[39m\n");
            aecho("\n");

            aecho("  To display the list of available commands, please use the \e[32mlist\e[39m command.\n");   
        }
        else if ($argc > 1 && $argv[2] == 'list')
        {
            aecho("\e[33mDescription:\e[39m\n");
            aecho("  List commands\n");
            aecho("\n");
            aecho("\e[33mUsage:\e[39m\n");
            aecho("  list [options] [--] [<namespace>]\n");
            aecho("\n");
            aecho("\e[33mArguments:\e[39m\n");
            aecho("  \e[32mnamespace\e[39m                      The namespace name\n");
            aecho("\n");

            options();
            aecho("\n");

            aecho("\e[33mHelp:\e[39m\n");
            aecho("  The \e[32mlist\e[39m command lists all commands:\n");
            aecho("\n");
            aecho("    \e[32mmuse list\e[39m\n");
            aecho("\n");
            aecho("  You can also display the commands for a specific namespace:\n");
            aecho("\n");
            aecho("    \e[32mmuse list test\e[39m\n");
            aecho("\n");
        }
        else if ($argc > 1 && $argv[2] == 'install')
        {
            // Check if next arg is 'vendor', 'check', or 'appdir' for subcommand help
            $subcommand = isset($argv[3]) ? $argv[3] : null;

            aecho("\e[33mDescription:\e[39m\n");
            if ($subcommand == 'vendor')
            {
                aecho("  Install composer dependencies only\n");
            }
            else if ($subcommand == 'check')
            {
                aecho("  Run pre-flight checks without installing\n");
            }
            else if ($subcommand == 'appdir')
            {
                aecho("  Create the app directory structure only\n");
            }
            else if ($subcommand == 'database')
            {
                aecho("  Configure database connection only\n");
            }
            else
            {
                aecho("  Run the HUBzero installation process\n");
            }
            aecho("\n");
            aecho("\e[33mUsage:\e[39m\n");
            aecho("  install [vendor|check|appdir|database] [options]\n");
            aecho("\n");
            aecho("\e[33mArguments:\e[39m\n");
            aecho("  \e[32mvendor\e[39m                          Install only composer dependencies\n");
            aecho("  \e[32mcheck\e[39m                           Run pre-flight checks without installing\n");
            aecho("  \e[32mappdir\e[39m                          Create the app directory structure only\n");
            aecho("  \e[32mdatabase\e[39m                        Configure database connection only\n");
            aecho("\n");
            options();
            aecho("\n");
            aecho("\e[33mHelp:\e[39m\n");
            aecho("  The \e[32minstall\e[39m command runs the full HUBzero installation:\n");
            aecho("\n");
            aecho("    \e[32mmuse install\e[39m\n");
            aecho("\n");
            aecho("  To install only composer dependencies:\n");
            aecho("\n");
            aecho("    \e[32mmuse install vendor\e[39m\n");
            aecho("\n");
            aecho("  To run pre-flight checks without installing:\n");
            aecho("\n");
            aecho("    \e[32mmuse install check\e[39m\n");
            aecho("\n");
            aecho("  To create just the app directory structure:\n");
            aecho("\n");
            aecho("    \e[32mmuse install appdir\e[39m\n");
            aecho("\n");
            aecho("  To configure the database connection:\n");
            aecho("\n");
            aecho("    \e[32mmuse install database\e[39m\n");
            aecho("\n");
            aecho("  If composer dependencies are not installed, they will be installed automatically\n");
            aecho("  before running the full installation.\n");
            aecho("\n");
        }
        else
        {
            aecho("\n",true);
            aecho("\e[37;41mERROR:\e[39;49m Command \"{$argv[2]}\" is not defined.\n",true);
            aecho("\n",true);

            aecho("\e[32mhelp [options] [--] [<command_name>]\e[39m\n");
            aecho("\n",true);    
        }

    }
    else if ($argv[1] == 'list')
    { 
        aecho("    __  ___\n");
        aecho("   /  |/  /_  __________ \n");
        aecho("  / /|_/ / / / / ___/ _ \\\n");
        aecho(" / /  / / /_/ (__  )  __/\n");
        aecho("/_/  /_/\__,_/____/\___/\n");
        aecho("\n");

        aecho("\e[32mMuse: HUBzero Command Line Interface\e[39m version \e[33m" . $minimalVersion . " (minimal)\e[39m " . $minimalDate . "\n");
        aecho("\n");

        aecho("\e[33mUsage:\e[39m\n");
        aecho("  command [options] [arguments]\n");
        aecho("\n");

        options();

        if ($argc <= 2)
        {
            aecho("\n");
            aecho("\e[33mAvailable Commands:\e[39m\n");
            aecho("  \e[32mhelp\e[39m                            Display help for a command\n");
            aecho("  \e[32mlist\e[39m                            List commands\n");
            aecho(" \e[33minstall\e[39m\n");
            aecho("  \e[32minstall\e[39m                         Run the full HUBzero installation process\n");
            aecho("  \e[32minstall appdir\e[39m                  Create the app directory structure only\n");
            aecho("  \e[32minstall check\e[39m                   Run pre-flight checks without installing\n");
            aecho("  \e[32minstall database\e[39m                Configure database connection only\n");
            aecho("  \e[32minstall vendor\e[39m                  Install composer dependencies only\n");
        }
        else if ($argc == 3)
        {
            if ($argv[2] == 'install')
            {
                aecho("\n");
                aecho("\e[33mAvailable commands for the \"install\" namespace:\e[39m\n");
                aecho("  \e[32minstall\e[39m          Run the full HUBzero installation process\n");
                aecho("  \e[32minstall appdir\e[39m   Create the app directory structure only\n");
                aecho("  \e[32minstall check\e[39m    Run pre-flight checks without installing\n");
                aecho("  \e[32minstall database\e[39m Configure database connection only\n");
                aecho("  \e[32minstall vendor\e[39m   Install composer dependencies only\n");
            }
            else
            {
                aecho("\n",true);
                aecho("\e[37;41mERROR:\e[39;49m There are no commands defined in the \"\e[33m{$argv[2]}\e[39m\" namespace.\n", true);
                aecho("\n",true);
                aecho("\e[32mlist\e[39m [<\e[33mnamespace\e[39m>]\n",true);
                aecho("\n",true);
            }
        }
        else
        {
            aecho("\n",true);
            aecho("\e[37;41mERROR:\e[39;49m Too many arguments to \"\e[32mlist\e[39m\" command, expected argument \"\e[33mnamespace\e[39m\".\n", true);
            aecho("\n",true);
            aecho("\e[32mlist\e[39m [<\e[33mnamespace\e[39m>]\n",true);
            aecho("\n",true);
        }
    }
    // Handle install command
    else if ($argv[1] == "install")
    {
        // In minimal mode, only certain subcommands are valid
        // Any other subcommand requires full muse
        $validSubcommands = ['vendor', 'check', 'appdir', 'database'];
        if (isset($argv[2]) && !in_array($argv[2], $validSubcommands))
        {
            aecho("\n", true);
            aecho("\e[37;41mERROR:\e[39;49m Command \"install {$argv[2]}\" is not available.\n", true);
            aecho("\n", true);
            aecho("Only \e[32mmuse install\e[39m, \e[32mmuse install check\e[39m, \e[32mmuse install vendor\e[39m, \e[32mmuse install appdir\e[39m, and \e[32mmuse install database\e[39m are available before dependencies are installed.\n", true);
            aecho("\n", true);
            exit(1);
        }

        $vendorOnly = (isset($argv[2]) && $argv[2] == "vendor");
        $checkOnly = (isset($argv[2]) && $argv[2] == "check");
        $appdirOnly = (isset($argv[2]) && $argv[2] == "appdir");
        $databaseOnly = (isset($argv[2]) && $argv[2] == "database");
        $vendorPath = dirname(__DIR__) . '/vendor/autoload.php';
        $force = in_array('--force', $argv);

        // For check-only mode, run all preflight checks (including vendor)
        if ($checkOnly)
        {
            require_once dirname(__DIR__) . '/libraries/Hubzero/Console/Command/Install/Preflight.php';

            $passed = Hubzero\Console\Command\Install\Preflight::check($ansi, dirname(dirname(__DIR__)), $force);

            aecho("\n");
            if ($passed)
            {
                aecho("\e[32mAll pre-flight checks passed!\e[39m\n");
            }
            else
            {
                aecho("\e[31mSome pre-flight checks failed.\e[39m\n", true);
            }
            aecho("\n");
            exit($passed ? 0 : 1);
        }

        // For appdir-only mode, create the app directory structure
        if ($appdirOnly)
        {
            require_once dirname(__DIR__) . '/libraries/Hubzero/Console/Command/Install/AppDirectory.php';

            $success = Hubzero\Console\Command\Install\AppDirectory::create($ansi, dirname(dirname(__DIR__)) . '/app');

            exit($success ? 0 : 1);
        }

        // For database-only mode, configure the database
        if ($databaseOnly)
        {
            require_once dirname(__DIR__) . '/libraries/Hubzero/Console/Command/Install/Database.php';

            $success = Hubzero\Console\Command\Install\Database::configure($ansi, dirname(dirname(__DIR__)) . '/app');

            exit($success ? 0 : 1);
        }

        // Install vendor dependencies if needed or if explicitly requested
        if (!file_exists($vendorPath) || $vendorOnly)
        {
            // Use shared vendor installation class
            require_once dirname(__DIR__) . '/libraries/Hubzero/Console/Command/Install/Vendor.php';

            if (!Hubzero\Console\Command\Install\Vendor::install($ansi, $quiet, dirname(__DIR__)))
            {
                exit(1);
            }

            // If vendor only, we're done
            if ($vendorOnly)
            {
                exit(0);
            }
        }

        // Run preflight checks for full install (vendor is now installed)
        require_once dirname(__DIR__) . '/libraries/Hubzero/Console/Command/Install/Preflight.php';

        if (!Hubzero\Console\Command\Install\Preflight::check($ansi, dirname(dirname(__DIR__)), $force))
        {
            exit(1);
        }

        // Vendor is now installed, load the autoloader and run full muse
        // Suppress session warnings in CLI mode - they're harmless when output has been sent
        // (session operations warn about "headers already sent" but work fine in CLI)
        $previousErrorLevel = error_reporting(E_ALL & ~E_WARNING);

        if (include($vendorPath))
        {
            (new Hubzero\Base\Application())->run();
        }
        else
        {
            aecho("\n", true);
            aecho("\e[37;41mERROR:\e[39;49m Failed to load composer autoloader.\n", true);
            aecho("\n", true);
            exit(1);
        }
    }
    else
    {
        aecho("\n",true);
        aecho("\e[37;41mERROR:\e[39;49m Command \"{$argv[1]}\" is not available.\n",true);
        aecho("\n",true);
        aecho("HUBzero is not installed yet. Muse is missing required dependencies\n",true);
        aecho("and cannot look up or run commands.\n",true);
        aecho("\n",true);
        aecho("To install HUBzero, run:\n",true);
        aecho("\n",true);
        aecho("    \e[32mmuse install\e[39m\n",true);
        aecho("\n",true);
    }
}
