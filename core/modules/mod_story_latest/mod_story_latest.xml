<?xml version="1.0" encoding="utf-8"?>
<extension type="module" version="2.5" client="site" method="upgrade">
	<name>mod_story_latest</name>
	<author>HUBzero</author>
	<authorUrl>hubzero.org</authorUrl>
	<copyright>Copyright (c) 2005-2020 The Regents of the University of California.</copyright>
	<license>http://opensource.org/licenses/MIT MIT</license>
	<description>MOD_STORY_LATEST_XML_DESCRIPTION</description>
	<files>
		<filename module="mod_story_latest">mod_story_latest.php</filename>
		<filename>helper.php</filename>
		<folder>tmpl</folder>
	</files>
	<languages folder="language">
		<language tag="en-GB">en-GB/en-GB.mod_story_latest.ini</language>
		<language tag="en-GB">en-GB/en-GB.mod_story_latest.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="limit" type="text" default="5" label="MOD_STORY_LATEST_LIMIT_LABEL" description="MOD_STORY_LATEST_LIMIT_DESC" />
				<field name="show_kicker" type="radio" default="1" label="MOD_STORY_LATEST_KICKER_LABEL" description="MOD_STORY_LATEST_KICKER_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_date" type="radio" default="1" label="MOD_STORY_LATEST_DATE_LABEL" description="MOD_STORY_LATEST_DATE_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
