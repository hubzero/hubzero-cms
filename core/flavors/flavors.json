{
    "default": {
        "description": "The CMS on its own, without simulation tools. What a hub is unless it has a tool middleware.",

        "components": {
            "disable": ["com_tools", "com_usage"]
        },

        "modules": {
            "disable": ["mod_mytools", "mod_mysessions"],
            "params": {
                "mod_mycontributions": {"show_tools": "0"}
            }
        },

        "plugins": {
            "params": {
                "members/dashboard": {"allow_customization": "1", "position": "memberDashboard"}
            }
        },

        "dashboard": {
            "tiles": [
                {"module": 44, "col": 1},
                {"module": 35, "col": 1},
                {"module": 38, "col": 1},
                {"module": 39, "col": 1},
                {"module": 33, "col": 2},
                {"module": 42, "col": 2},
                {"module": 34, "col": 2},
                {"module": 37, "col": 3}
            ]
        },

        "kb": {
            "categories": {"tools": 0},
            "articles": {"webdav": 0}
        },

        "resource_types": {
            "tools": {"contributable": 0}
        }
    },

    "full": {
        "extends": "default",
        "description": "The CMS with simulation tools: everything the default flavor turns off, on. For a hub with a tool middleware behind it.",

        "components": {
            "enable": ["com_tools", "com_usage"]
        },

        "modules": {
            "enable": ["mod_mytools", "mod_mysessions"],
            "params": {
                "mod_mycontributions": {"show_tools": "1"}
            }
        },

        "dashboard": {
            "tiles": [
                {"module": 44, "col": 1},
                {"module": 35, "col": 1},
                {"module": 38, "col": 1},
                {"module": 39, "col": 1},
                {"module": 33, "col": 2},
                {"module": 42, "col": 2},
                {"module": 34, "col": 2},
                {"module": 41, "col": 3},
                {"module": 36, "col": 3},
                {"module": 37, "col": 3}
            ]
        },

        "kb": {
            "categories": {"tools": 1},
            "articles": {"webdav": 1}
        },

        "resource_types": {
            "tools": {"contributable": 1}
        }
    }
}
