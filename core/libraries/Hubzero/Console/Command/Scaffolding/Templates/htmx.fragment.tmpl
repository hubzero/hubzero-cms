defined('_HZEXEC_') or die();

$records = isset($records) ? $records : ($this->records ?? array());
$routes = isset($routes) ? $routes : ($this->routes ?? array());
?>
<div id="%=component_name=%-%=view=%-panel"
    x-data="{ flash: '' }"
    x-on:%=component_name=%:created.window="flash = 'Created!'; setTimeout(() => flash = '', 1400)">

    <template x-if="flash">
        <p class="notice" role="status" x-text="flash"></p>
    </template>

    <form
        action="<?php echo $routes['create'] ?? ''; ?>"
        method="post"
        hx-post="<?php echo $routes['create'] ?? ''; ?>"
        hx-target="#%=component_name=%-%=view=%-panel"
        hx-swap="outerHTML">
        <?php echo Html::input('token'); ?>
        <?php echo \Hubzero\Htmx\Htmx::renderDebugHiddenInput(); ?>
        <button type="submit">Create Row</button>
    </form>

    <ul>
        <?php foreach ($records as $row): ?>
            <li><?php echo htmlspecialchars((string) ($row['title'] ?? ''), ENT_QUOTES, 'UTF-8'); ?></li>
        <?php endforeach; ?>
    </ul>
</div>
