<?xml version="1.0"?>
<ruleset name="HubZero">
    <description>PSR-12</description>

    <file>core/bootstrap</file>
    <file>core/components</file>
    <file>core/libraries</file>
    <file>core/migrations</file>
    <file>core/modules</file>
    <file>core/plugins</file>
    <file>core/templates</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/Tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="4"/>
    <arg value="np"/>
    <ini name="memory_limit" value="-1"/>

    <rule ref="PSR12"/>
</ruleset>
