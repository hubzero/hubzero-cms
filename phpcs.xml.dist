<?xml version="1.0"?>
<ruleset name="HubZero">
    <description>PSR-12, minus the two method-name sniffs the legacy API cannot satisfy</description>

    <file>core/bootstrap</file>
    <file>core/components</file>
    <file>core/libraries</file>
    <file>core/migrations</file>
    <file>core/modules</file>
    <file>core/plugins</file>
    <file>core/templates</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/Tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="4"/>
    <arg value="np"/>
    <ini name="memory_limit" value="-1"/>

    <rule ref="PSR12">
        <!-- Hundreds of _prefixed and snake_case methods are public API that
             hub-specific code and templates call; renaming them is a
             compatibility break, not a style fix. -->
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
    </rule>
</ruleset>
