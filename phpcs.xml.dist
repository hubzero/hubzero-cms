<?xml version="1.0"?>
<ruleset name="HubZero">
    <description>PSR-12</description>

    <file>core/bootstrap</file>
    <file>core/components</file>
    <file>core/libraries</file>
    <file>core/migrations</file>
    <file>core/modules</file>
    <file>core/plugins</file>
    <file>core/templates</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="4"/>
    <arg value="p"/>
    <ini name="memory_limit" value="-1"/>

    <!-- PER-CS writes an empty body as {} on the line before it, which three
         PSR-12 sniffs reject. .phpcs/HubzeroPER carries the same three sniffs
         with that one case let through, and a fourth that requires it. -->
    <rule ref="PSR12">
        <exclude name="PSR2.Classes.ClassDeclaration"/>
        <exclude name="Squiz.Functions.MultiLineFunctionDeclaration"/>
        <exclude name="Squiz.WhiteSpace.ScopeClosingBrace"/>
    </rule>
    <rule ref="./.phpcs/HubzeroPER"/>

    <!-- PSR-12 MUSTs that phpcs reports only as warnings -->
    <rule ref="PSR2.Classes.PropertyDeclaration.Underscore">
        <type>error</type>
    </rule>
    <rule ref="PSR12.Properties.ConstantVisibility.NotFound">
        <type>error</type>
    </rule>
</ruleset>
